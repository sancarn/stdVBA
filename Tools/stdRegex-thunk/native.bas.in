' Experimental Windows x86/x64 native matcher; generated bytes have no relocations.
Private Declare PtrSafe Function VirtualAlloc Lib "kernel32" (ByVal address As LongPtr, ByVal size As LongPtr, ByVal allocation As Long, ByVal protection As Long) As LongPtr
Private Declare PtrSafe Function VirtualProtect Lib "kernel32" (ByVal address As LongPtr, ByVal size As LongPtr, ByVal protection As Long, ByRef previous As Long) As Long
Private Declare PtrSafe Function VirtualFree Lib "kernel32" (ByVal address As LongPtr, ByVal size As LongPtr, ByVal freeType As Long) As Long
Private Declare PtrSafe Sub CopyMemory Lib "kernel32" Alias "RtlMoveMemory" (ByVal target As LongPtr, ByVal source As LongPtr, ByVal size As LongPtr)
Private Declare PtrSafe Function FlushInstructionCache Lib "kernel32" (ByVal process As LongPtr, ByVal address As LongPtr, ByVal size As LongPtr) As Long
Private Declare PtrSafe Function CallWindowProc Lib "user32" Alias "CallWindowProcW" (ByVal code As LongPtr, ByRef args As NativeArgs, ByVal unused As Long, ByVal unused2 As LongPtr, ByVal unused3 As LongPtr) As LongPtr
Private Type NativeArgs
  bytecode As LongPtr
  canon As LongPtr
  text As LongPtr
  work As LongPtr
  captures As LongPtr
  length As Long
  start As Long
  limit As Long
  multiline As Long
  dotall As Long
  raiseLimit As Long
  capacity As Long
  bytecodeLength As Long
End Type

' @PROCEDURES@
Private Function NativeCode() As LongPtr
#If Mac Then
  Err.Raise 5, "stdRegexThunk", "This experiment requires Windows VBA7"
#Else
  If This.nativeCode = 0 Then
    Dim hexCode As String
#If Win64 Then
    ' @HEX_X64@
#Else
    ' @HEX_X86@
#End If
    Dim bytes() As Byte, i As Long, oldProtection As Long, p As LongPtr
    ReDim bytes(0 To Len(hexCode) \ 2 - 1)
    For i = 0 To UBound(bytes)
      bytes(i) = CByte("&H" & Mid$(hexCode, 2 * i + 1, 2))
    Next
    p = VirtualAlloc(0, UBound(bytes) + 1, &H3000, &H4)
    If p = 0 Then Err.Raise 7, "stdRegexThunk", "Cannot allocate native matcher"
    CopyMemory p, VarPtr(bytes(0)), UBound(bytes) + 1
    If VirtualProtect(p, UBound(bytes) + 1, &H20, oldProtection) = 0 Then
      VirtualFree p, 0, &H8000
      Err.Raise 5, "stdRegexThunk", "Cannot make native matcher executable"
    End If
    If FlushInstructionCache(-1, p, UBound(bytes) + 1) = 0 Then
      VirtualFree p, 0, &H8000
      Err.Raise 5, "stdRegexThunk", "Cannot flush native matcher instruction cache"
    End If
    This.nativeCode = p
  End If
  NativeCode = This.nativeCode
#End If
End Function

Private Sub Class_Terminate()
  If This.nativeCode <> 0 Then VirtualFree This.nativeCode, 0, &H8000
End Sub

Private Function NativeMatch(ByRef outCaptures As CapturesTy, ByRef bytecode() As Long, ByRef inputStr As String, ByVal sp As Long, ByVal stepsLimit As Long, ByVal multiline As Boolean, ByVal dotAll As Boolean, ByVal raiseOnLimit As Boolean) As Long
  Dim a As NativeArgs, points() As Long, n As Long, i As Long, result As Long, p As LongPtr
  p = NativeCode()
  n = bytecode(0) + 1
  ReDim points(0 To n + bytecode(1) - 1)
  a.bytecode = VarPtr(bytecode(0))
  a.bytecodeLength = UBound(bytecode) + 1
  a.canon = VarPtr(This.regex.bytecode(UNICODE_CANON_LOOKUP_TABLE_START))
  a.text = StrPtr(inputStr)
  a.captures = VarPtr(points(0))
  a.length = Len(inputStr): a.start = sp: a.limit = stepsLimit
  a.multiline = Abs(CLng(multiline)): a.dotall = Abs(CLng(dotAll)): a.raiseLimit = Abs(CLng(raiseOnLimit))
  If This.nativeCapacity = 0 Then
    This.nativeCapacity = 4096
    ReDim This.nativeWork(0 To 3 * This.nativeCapacity - 1)
  End If
  Do
    a.work = VarPtr(This.nativeWork(0)): a.capacity = This.nativeCapacity
    result = CLng(CallWindowProc(p, a, 0, 0, 0))
    If result <> -3 Then Exit Do
    If This.nativeCapacity > 16777216 Then Err.Raise 7, "stdRegexThunk", "Native matcher workspace exhausted"
    This.nativeCapacity = This.nativeCapacity * 2
    ReDim This.nativeWork(0 To 3 * This.nativeCapacity - 1)
  Loop
  If result = -2 Then Err.Raise REGEX_ERR_STEP_LIMIT, "stdRegexThunk", "Regex processing step limit exceeded"
  If result = -4 Then Err.Raise 3000, "stdRegexThunk", "Invalid native matcher bytecode"
  NativeMatch = result
  If result < 0 Then Exit Function
  With outCaptures
    .nNumberedCaptures = n \ 2 - 1: .nNamedCaptures = bytecode(1)
    If .nNumberedCaptures > 0 Then ReDim .numberedCaptures(0 To .nNumberedCaptures - 1)
    If .nNamedCaptures > 0 Then ReDim .namedCaptures(0 To .nNamedCaptures - 1)
    .entireMatch.start = 0: .entireMatch.length = 0
    If points(0) >= 0 And points(1) >= points(0) Then
      .entireMatch.start = points(0) + 1: .entireMatch.length = points(1) - points(0)
    End If
    For i = 1 To .nNumberedCaptures
      If points(2 * i) >= 0 And points(2 * i + 1) >= points(2 * i) Then
        .numberedCaptures(i - 1).start = points(2 * i) + 1
        .numberedCaptures(i - 1).length = points(2 * i + 1) - points(2 * i)
      End If
    Next
    For i = 0 To .nNamedCaptures - 1
      .namedCaptures(i) = points(n + i)
    Next
  End With
End Function
