    If p = 0 Then Err.Raise 7, "stdRegex", "Cannot allocate native matcher"
    CopyMemory p, VarPtr(bytes(0)), UBound(bytes) + 1
    If VirtualProtect(p, UBound(bytes) + 1, &H20, oldProtection) = 0 Then
      VirtualFree p, 0, &H8000
